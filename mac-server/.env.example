# Turso (libSQL) database — same values the web app uses.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
# Vercel Blob storage for stem uploads.
BLOB_READ_WRITE_TOKEN=your-blob-rw-token
API_SECRET=your-api-secret-here
OUTPUT_DIR=/tmp/mojo-stems
# Bump only when cached compute artifacts are incompatible with new models or
# pipeline logic. Retries and repeat imports reuse matching versions.
PIPELINE_VERSION=hq-v4-guitar-focus
WORKER_ID=mac-worker-local
WORKER_CONCURRENCY=1
QUEUE_POLL_INTERVAL_SECONDS=0.5
JOB_HEARTBEAT_INTERVAL_SECONDS=15
JOB_HEARTBEAT_TIMEOUT_SECONDS=300
JOB_MAX_BACKOFF_SECONDS=300
DEMUCS_PYTHON=./venv/bin/python

# YouTube changes independently of the system release cycle. The worker
# refreshes yt-dlp at startup (at most daily) and once in-job after a
# recoverable 403/challenge failure. Node 22+ or Deno 2.3+ must be installed.
# YTDLP_JS_RUNTIME=node:/opt/homebrew/bin/node
YTDLP_AUTO_UPDATE_ON_FAILURE=true
YTDLP_UPDATE_INTERVAL_SECONDS=86400
DEMUCS_DEVICE=mps
DEMUCS_JOBS=4
# Primary separation is a coherent six-stem BS-RoFormer pass directly from the
# original. The model is downloaded into SEPARATOR_MODEL_DIR on first use.
PRIMARY_SEPARATION_MODEL=BS-Roformer-SW.ckpt
# Fast six-stem fallback if the primary model is unavailable.
DEMUCS_MODEL=htdemucs_6s
# Shift trick: >1 averages multiple randomly-shifted passes for slightly
# cleaner output; each extra shift multiplies separation time.
DEMUCS_SHIFTS=1
# DEMUCS_SEGMENT=10
# Second-pass vocal refine with BS-Roformer (needs mac-server/venv-sep:
# python3.11 -m venv venv-sep && venv-sep/bin/pip install "audio-separator[cpu]").
# Falls back silently to Demucs vocals when disabled/missing/failing.
VOCAL_REFINE_ENABLED=true
# VOCAL_REFINE_MODEL=model_bs_roformer_ep_317_sdr_12.9755.ckpt
# Independent direct-guitar coverage pass. It reads the untouched original and
# fills only phrases clearly missed by the primary six-stem model.
GUITAR_REFINE_ENABLED=true
# GUITAR_REFINE_MODEL=mel_band_roformer_guitar_becruily.ckpt
# Learner playback keeps a quiet original bed under the isolated guitar to
# preserve natural attacks and mask separation artifacts.
GUITAR_FOCUS_BACKGROUND_GAIN=0.24
# Lead/Rhythm Focus keeps this much of the complete guitar signal underneath
# the note-guided role mask. Higher is safer; lower separates more strongly.
GUITAR_ROLE_BASE_GAIN=0.30
# SEPARATOR_MODEL_DIR=~/Library/Application Support/MrMojoRising/separator-models
# Benchmark-gated only: mixed precision can be faster on Apple GPU, but stays
# off by default until output quality is validated on a representative set.
SEPARATOR_USE_AUTOCAST=false
# Tab transcription: basic-pitch on the guitar stem → tab_notes rows (needs
# venv-sep: venv-sep/bin/pip install "basic-pitch[onnx]"). Non-fatal when
# disabled/missing/failing — songs still complete without tabs.
TAB_TRANSCRIBE_ENABLED=true
# BASIC_PITCH_BIN=./venv-sep/bin/basic-pitch
# TAB_ONSET_THRESHOLD=0.6
# TAB_FRAME_THRESHOLD=0.4
# TAB_MIN_NOTE_MS=70
# TAB_TIMEOUT_SECONDS=600
# LYRICS_ALIGN_ENABLED=true
# LYRICS_ALIGN_MODEL=mlx-community/whisper-large-v3-turbo
# LYRICS_ALIGN_TIMEOUT_SECONDS=600
WORKER_WARMUP_ENABLED=true
